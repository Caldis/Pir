    <item>
      <title>Pir 0.1.8</title>
      <sparkle:version>20261027.1</sparkle:version>
      <sparkle:shortVersionString>0.1.8</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <pubDate>Wed, 28 Oct 2026 02:50:13 +0000</pubDate>
      <description>&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset="utf-8"&gt;&lt;/head&gt;&lt;body&gt;&lt;h2&gt;Pir 0.1.8&lt;/h2&gt;&lt;p&gt;修复 Retina 屏幕上菜单栏图标模糊的问题&lt;/p&gt;&lt;p&gt;Fix blurry menu bar icons on Retina displays.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;
